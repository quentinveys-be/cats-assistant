<UserControl x:Class="CatsAssistant.App.Views.CatchUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CatsAssistant.App.ViewModels"
             xmlns:conv="clr-namespace:CatsAssistant.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:CatchUpViewModel}">

    <UserControl.Resources>
        <conv:FractionToGridLengthConverter x:Key="FractionToGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Bouton plein accent ("Tout valider jour par jour", "Valider et continuer", "Valider ce jour"). -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton neutre ("Ouvrir la journée", "Ignorer"). -->
        <Style x:Key="NeutralButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip de statut jour : couleur choisie par la vue selon Status, jamais par le VM. -->
        <DataTemplate x:Key="StatusChipTemplate" DataType="{x:Type vm:CatchUpDayViewModel}">
            <Border x:Name="ChipBg" Height="22" Padding="8,0" CornerRadius="11" BorderThickness="1"
                    Background="{DynamicResource NeutralBgBrush}" BorderBrush="{DynamicResource NeutralStrokeBrush}">
                <TextBlock x:Name="ChipText" Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource NeutralChipBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Incomplete">
                    <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource CriticalBgBrush}" />
                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource CriticalStrokeBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeedsReview">
                    <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource CautionBgBrush}" />
                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource CautionStrokeBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ReadyToValidate">
                    <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource AccentTintBrush}" />
                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Validated">
                    <Setter TargetName="ChipBg" Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                    <Setter TargetName="ChipBg" Property="BorderBrush" Value="{DynamicResource SuccessStrokeBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Carte d'une journée. -->
        <DataTemplate x:Key="CatchUpDayTemplate" DataType="{x:Type vm:CatchUpDayViewModel}">
            <Border x:Name="Card" CornerRadius="6" BorderThickness="1" Padding="14,12" Margin="0,0,0,8"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding LongLabel}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillPrimaryBrush}" />
                        <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding ProposedLabel}" FontSize="13" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillPrimaryBrush}" />
                            <TextBlock Margin="6,0,0,0" FontSize="12" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource TextFillTertiaryBrush}">
                                <Run Text="/" /> <Run Text="{Binding ExpectedLabel, Mode=OneWay}" /> <Run Text="attendues" />
                            </TextBlock>
                            <TextBlock x:Name="PercentText" Text="{Binding PercentLabel}" FontSize="12" FontWeight="SemiBold"
                                       Margin="12,0,0,0" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource CriticalBrush}" />
                        </StackPanel>
                        <Grid Height="6">
                            <Border CornerRadius="3" Background="{DynamicResource SubtleFillTertiaryBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding GaugeFraction, Converter={StaticResource FractionToGridLengthConverter}}" />
                                    <ColumnDefinition Width="{Binding GaugeRemainder, Converter={StaticResource FractionToGridLengthConverter}}" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="GaugeFill" Grid.Column="0" CornerRadius="3" Background="{DynamicResource CriticalBrush}" />
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatusChipTemplate}"
                                     VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False" />

                    <Button Grid.Column="3" Content="Ouvrir la journée" Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding OpenCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="{Binding LongLabel, StringFormat='Ouvrir la journée {0}'}" />

                    <Button Grid.Column="4" Content="{Binding ValidateLabel}" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ValidateCommand}"
                            AutomationProperties.Name="{Binding LongLabel, StringFormat='Valider la journée {0}'}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PercentToneKey}" Value="Success">
                    <Setter TargetName="PercentText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter TargetName="GaugeFill" Property="Background" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PercentToneKey}" Value="Caution">
                    <Setter TargetName="PercentText" Property="Foreground" Value="{DynamicResource CautionBrush}" />
                    <Setter TargetName="GaugeFill" Property="Background" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentWalkDay}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" VerticalAlignment="Bottom">
            <Button DockPanel.Dock="Right" Content="Tout valider jour par jour" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding StartWalkCommand}" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillPrimaryBrush}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillTertiaryBrush}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="10,10" CornerRadius="4" BorderThickness="1,1,1,1"
                Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource AccentStrokeBrush}"
                Visibility="{Binding IsWalking, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding WalkLabel}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,12,0" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillSecondaryBrush}">
                    <Run Text="{Binding WalkDayLabel, Mode=OneWay}" />
                    <Run Text=" — vérifiez les lignes, puis validez. Aucune journée n'est validée sans votre clic." />
                </TextBlock>
                <Button Content="Valider et continuer" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding WalkValidateCommand}" Margin="0,0,8,0" />
                <Button Content="Ignorer" Style="{StaticResource NeutralButtonStyle}" Command="{Binding WalkSkipCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource CatchUpDayTemplate}" Focusable="False" />
        </ScrollViewer>
    </Grid>
</UserControl>
