<Window x:Class="CatsAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CatsAssistant.App.ViewModels"
        xmlns:views="clr-namespace:CatsAssistant.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CATS Assistant" Height="840" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ScreenViewModelBase}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Barre de titre -->
            <Border Grid.Row="0" Background="{StaticResource LayerBackgroundBrush}"
                    BorderBrush="{StaticResource DividerStrokeBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource AccentFillBrush}" StrokeThickness="1.5"
                              Data="M12,3 A9,9 0 1 1 11.99,3 M12,7.5 V12 L15,14" />
                        <TextBlock Text="CATS Assistant" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextFillPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMinimizeClick" AutomationProperties.Name="Réduire">
                            <Path Data="M0,5 H10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMaximizeRestoreClick" AutomationProperties.Name="Agrandir">
                            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseTitleBarButtonStyle}"
                                Click="OnCloseClick" AutomationProperties.Name="Fermer">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rail de navigation + contenu -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Background="{StaticResource LayerBackgroundBrush}" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,12">
                        <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource AccentTintBrush}"
                                BorderBrush="{StaticResource AccentStrokeBrush}" BorderThickness="1" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CATS Assistant" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextFillPrimaryBrush}" />
                            <TextBlock Text="Saisie des temps" FontSize="12" Foreground="{StaticResource TextFillTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" Margin="8,0,8,0" ItemsSource="{Binding NavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" Focusable="False" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,8">
                        <Border BorderBrush="{StaticResource DividerStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource FooterButtonStyle}" Content="Thème"
                                        Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="Thème" />
                                <ContentControl Content="{Binding SettingsItem}"
                                                ContentTemplate="{StaticResource NavigationItemTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <ContentControl Grid.Column="1" Content="{Binding CurrentScreen}" />
            </Grid>

            <!-- Barre d'état -->
            <Border Grid.Row="2" Background="{StaticResource LayerBackgroundBrush}"
                    BorderBrush="{StaticResource DividerStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0,14,0">
                    <ItemsControl ItemsSource="{Binding StatusBar.Pills}" ItemTemplate="{StaticResource ConnectorPillTemplate}"
                                  HorizontalAlignment="Left" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusBar.PeriodText}" FontSize="12" Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextFillTertiaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
