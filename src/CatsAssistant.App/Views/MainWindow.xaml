<Window x:Class="CatsAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CatsAssistant.App.ViewModels"
        xmlns:views="clr-namespace:CatsAssistant.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CATS Assistant" Height="840" Width="1280" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ScreenViewModelBase}">
            <views:PlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Barre de titre -->
            <Border Grid.Row="0" Background="{DynamicResource LayerBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentFillBrush}" StrokeThickness="1.5"
                              Data="M12,3 A9,9 0 1 1 11.99,3 M12,7.5 V12 L15,14" />
                        <TextBlock Text="CATS Assistant" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMinimizeClick" AutomationProperties.Name="Réduire">
                            <Path Data="M0,5 H10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMaximizeRestoreClick" AutomationProperties.Name="Agrandir">
                            <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseTitleBarButtonStyle}"
                                Click="OnCloseClick" AutomationProperties.Name="Fermer">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Rail de navigation + contenu -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Background="{DynamicResource LayerBackgroundBrush}" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,12">
                        <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AccentTintBrush}"
                                BorderBrush="{DynamicResource AccentStrokeBrush}" BorderThickness="1" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CATS Assistant" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillPrimaryBrush}" />
                            <TextBlock Text="Saisie des temps" FontSize="12" Foreground="{DynamicResource TextFillTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" Margin="8,0,8,0" ItemsSource="{Binding NavigationItems}"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}" Focusable="False" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,8">
                        <Border BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource FooterButtonStyle}" Command="{Binding ToggleThemeCommand}"
                                        AutomationProperties.Name="Thème">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="14" Height="14" Margin="0,0,8,0">
                                            <Path Stretch="Uniform" Stroke="{DynamicResource TextFillSecondaryBrush}" StrokeThickness="1.3"
                                                  Data="M7,7 m-3,0 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M7,0 L7,1.5 M7,12.5 L7,14 M0,7 L1.5,7 M12.5,7 L14,7 M2.05,2.05 L3.1,3.1 M10.9,10.9 L11.95,11.95 M2.05,11.95 L3.1,10.9 M10.9,3.1 L11.95,2.05">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Stretch="Uniform" Fill="{DynamicResource TextFillSecondaryBrush}"
                                                  Data="M9,1.5 A6,6 0 1 0 9,12.5 A4.6,4.6 0 1 1 9,1.5 Z" Visibility="Collapsed">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                        <TextBlock Text="Thème" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ContentControl Content="{Binding SettingsItem}"
                                                ContentTemplate="{StaticResource NavigationItemTemplate}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <ContentControl Grid.Column="1" Content="{Binding CurrentScreen}" />
            </Grid>

            <!-- Barre d'état -->
            <Border Grid.Row="2" Background="{DynamicResource LayerBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0,14,0">
                    <ItemsControl ItemsSource="{Binding StatusBar.Pills}" ItemTemplate="{StaticResource ConnectorPillTemplate}"
                                  HorizontalAlignment="Left" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusBar.PeriodText}" FontSize="12" Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource TextFillTertiaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
