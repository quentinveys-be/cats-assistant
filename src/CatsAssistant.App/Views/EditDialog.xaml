<Window x:Class="CatsAssistant.App.Views.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CatsAssistant.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource LayerBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=TicketBox}"
        d:DataContext="{d:DesignInstance vm:EditDialogViewModel}">

    <Window.Resources>
        <!-- Bouton − / + d'un stepper (plage horaire ou durée), cible 30×32. -->
        <Style x:Key="StepperButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- Valeur centrale d'un stepper. -->
        <Style x:Key="StepperValueStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
            <Setter Property="BorderThickness" Value="0,1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        </Style>

        <!-- Champ lecture seule (POSID / ZWPID). -->
        <Style x:Key="ReadOnlyFieldStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondaryBrush}" />
        </Style>

        <!-- Libellé de champ. -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Compteur n / 80 : warn > 70, err > 80 (prototype). -->
        <Style x:Key="NoteCounterStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillTertiaryBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NoteSeverity}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoteSeverity}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Badge de vérification des codes : neutre, ou warn si le ticket n'a pas de codes extraits. -->
        <Style x:Key="VerificationChipStyle" TargetType="ContentControl" BasedOn="{StaticResource NeutralStatusChipStyle}">
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerificationIsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CautionBgBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CautionStrokeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre + sous-titre -->
        <StackPanel Grid.Row="0" Margin="20,16,20,0">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillTertiaryBrush}" />
        </StackPanel>

        <!-- Corps -->
        <StackPanel Grid.Row="1" Margin="20,16,20,18">

            <!-- Plage horaire (activité capturée, plage CATS, zone à imputer) -->
            <StackPanel Visibility="{Binding HasRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Plage horaire" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding StartMinusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Début 15 minutes plus tôt" />
                    <Border Style="{StaticResource StepperValueStyle}" Width="66">
                        <TextBlock Text="{Binding StartLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillPrimaryBrush}" />
                    </Border>
                    <Button Content="+" Command="{Binding StartPlusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Début 15 minutes plus tard" />

                    <Path Data="M2,7 L12,7 M8,3 L12,7 L8,11" Stroke="{DynamicResource TextFillTertiaryBrush}"
                          StrokeThickness="1.5" VerticalAlignment="Center" Margin="10,0" />

                    <Button Content="−" Command="{Binding EndMinusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Fin 15 minutes plus tôt" />
                    <Border Style="{StaticResource StepperValueStyle}" Width="66">
                        <TextBlock Text="{Binding EndLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillPrimaryBrush}" />
                    </Border>
                    <Button Content="+" Command="{Binding EndPlusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Fin 15 minutes plus tard" />

                    <TextBlock Text="{Binding RangeHint}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Durée imputée (ligne CATS) -->
            <StackPanel Visibility="{Binding HasDuration, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,14">
                <TextBlock Text="Durée imputée" Style="{StaticResource FieldLabelStyle}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding DurationMinusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Réduire la durée de 0,25 heure" />
                    <Border Style="{StaticResource StepperValueStyle}" Width="92">
                        <TextBlock Text="{Binding DurationLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource TextFillPrimaryBrush}" />
                    </Border>
                    <Button Content="+" Command="{Binding DurationPlusCommand}" Style="{StaticResource StepperButtonStyle}"
                            AutomationProperties.Name="Augmenter la durée de 0,25 heure" />

                    <TextBlock Text="{Binding DurationHint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Ticket JIRA (autocomplete parmi les tickets assignés) -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Ticket JIRA" Style="{StaticResource FieldLabelStyle}" />
                <Border Height="32" Padding="10,0" CornerRadius="4"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1,1,1,2">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10.5,10.5 L14,14 M6.5,11 A4.5,4.5 0 1 1 6.5,2 A4.5,4.5 0 1 1 6.5,11"
                              Stroke="{DynamicResource TextFillTertiaryBrush}" StrokeThickness="1.5"
                              Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="TicketBox" Width="460" BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="14"
                                 Foreground="{DynamicResource TextFillPrimaryBrush}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="TicketBox_GotKeyboardFocus"
                                 PreviewKeyDown="TicketBox_PreviewKeyDown"
                                 AutomationProperties.Name="Rechercher parmi mes tickets assignés" />
                    </StackPanel>
                </Border>

                <Popup IsOpen="{Binding IsListOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=TicketBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="8"
                       Width="518">
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4"
                            BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                            Effect="{StaticResource FlyoutShadowEffect}" Margin="0,0,8,8">
                        <StackPanel>
                            <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" MaxHeight="220"
                                     BorderThickness="0" Background="Transparent"
                                     KeyDown="SuggestionList_KeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Visibility="{Binding NoMatch, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                     AutomationProperties.Name="Tickets assignés correspondants">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SuggestionItem_MouseUp" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TicketSuggestion}">
                                        <DockPanel LastChildFill="False" Width="470">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Key}"
                                                       Style="{StaticResource MonoTextStyle}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontSize="13"
                                                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290"
                                                       Foreground="{DynamicResource TextFillPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <ContentControl DockPanel.Dock="Right" Content="{Binding Status}"
                                                            Style="{StaticResource NeutralStatusChipStyle}"
                                                            FontWeight="Normal" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Aucun ticket assigné ne correspond." FontSize="13" Margin="10,8"
                                       Foreground="{DynamicResource TextFillTertiaryBrush}"
                                       Visibility="{Binding NoMatch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- Note (LONGTEXT_DATA) + compteur -->
            <StackPanel Margin="0,0,0,14">
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" Text="Note (LONGTEXT_DATA)" FontSize="13"
                               Foreground="{DynamicResource TextFillSecondaryBrush}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding NoteCounter}" Style="{StaticResource NoteCounterStyle}" />
                </DockPanel>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="54" Padding="7,5"
                         TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                         FontSize="14" Background="{DynamicResource CardBackgroundBrush}"
                         Foreground="{DynamicResource TextFillPrimaryBrush}"
                         BorderBrush="{DynamicResource ControlStrokeBrush}"
                         AutomationProperties.Name="Note envoyée à SAP, 80 caractères maximum" />
            </StackPanel>

            <!-- POSID / ZWPID en lecture seule + badge -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Élément d'OTP (POSID)" Style="{StaticResource FieldLabelStyle}" />
                    <Border Style="{StaticResource ReadOnlyFieldStyle}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding PosidDisplay}"
                                       Style="{StaticResource MonoTextStyle}" FontSize="13" VerticalAlignment="Center" />
                            <ContentControl DockPanel.Dock="Right" Content="{Binding VerificationLabel}"
                                            Style="{StaticResource VerificationChipStyle}" Height="18"
                                            VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Activité (ZWPID)" Style="{StaticResource FieldLabelStyle}" />
                    <Border Style="{StaticResource ReadOnlyFieldStyle}">
                        <TextBlock Text="{Binding ZwpidDisplay}" Style="{StaticResource MonoTextStyle}" FontSize="13"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Codes issus du champ JIRA « Code imputation » (customfield_10045), en lecture seule."
                       Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Pied : Fusionner · action destructive · Annuler · Enregistrer -->
        <Border Grid.Row="2" Padding="14,14,20,14" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeBrush}"
                Background="{DynamicResource CardBackgroundSecondaryBrush}">
            <DockPanel LastChildFill="False">
                <!-- ponytail : « Fusionner » est un stub dans le prototype (ferme sans effet) ; désactivé en
                     attendant une sémantique de fusion définie. -->
                <Button DockPanel.Dock="Left" Content="Fusionner" IsEnabled="False"
                        Style="{StaticResource SecondaryButtonStyle}" Height="32"
                        ToolTip="Fusion des plages adjacentes — à venir"
                        ToolTipService.ShowOnDisabled="True" />
                <Button DockPanel.Dock="Left" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"
                        Height="32" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DestructiveButtonStyle}">
                            <Style.Triggers>
                                <!-- Désactivé quand l'action revient à apprendre une règle d'exclusion
                                     (« non facturable »), issue dédiée hors périmètre #19. -->
                                <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                    <Setter Property="ToolTip"
                                            Value="Cette action arrive avec l'apprentissage de règles depuis la correction" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button DockPanel.Dock="Right" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="8,0,0,0" IsDefault="True" />
                <Button DockPanel.Dock="Right" Content="Annuler" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="32" IsCancel="True" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
