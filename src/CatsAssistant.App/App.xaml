<Application x:Class="CatsAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CatsAssistant.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 : dictionnaire de thème (clair par défaut), remplacé à l'exécution par
                     ThemeService pour la bascule clair/sombre (issue #16). -->
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
                <ResourceDictionary Source="Themes/ShellStyles.xaml" />
                <ResourceDictionary Source="Themes/TimelineStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
