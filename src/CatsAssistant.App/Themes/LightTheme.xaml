<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Jetons couleur thème clair — docs/design/tokens/design-tokens.dc.html (issue #16). Le thème sombre
         (DarkTheme.xaml) reprend exactement les mêmes clés. -->

    <Color x:Key="SystemAccentColor">#5980A6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="SubtleFillSecondaryBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SubtleFillTertiaryBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SmokeFillBrush" Color="#4D000000" />

    <SolidColorBrush x:Key="DividerStrokeBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D8D8D8" />
    <SolidColorBrush x:Key="ControlStrokeStrongBrush" Color="#C6C6C6" />

    <SolidColorBrush x:Key="TextFillPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextFillTertiaryBrush" Color="#767676" />
    <SolidColorBrush x:Key="TextFillDisabledBrush" Color="#A0A0A0" />

    <SolidColorBrush x:Key="AccentFillBrush" Color="#4B6E92" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#41628A" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#37546F" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3D5A79" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#ECF1F6" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#B9CBDC" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#E6F4E6" />
    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#B6DDB6" />
    <SolidColorBrush x:Key="CautionBrush" Color="#8A5300" />
    <SolidColorBrush x:Key="CautionBgBrush" Color="#FBF0DC" />
    <SolidColorBrush x:Key="CautionStrokeBrush" Color="#E5C58F" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#B02A1B" />
    <SolidColorBrush x:Key="CriticalBgBrush" Color="#FDECEA" />
    <!-- Pas de trait critique dans les jetons de la maquette : interpolé entre CriticalBrush et
         CriticalBgBrush selon le même ratio que les autres traits sémantiques (~80% vers le fond). -->
    <SolidColorBrush x:Key="CriticalStrokeBrush" Color="#F0C4BE" />
    <SolidColorBrush x:Key="NeutralChipBrush" Color="#616161" />
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#EFEFEF" />
    <SolidColorBrush x:Key="NeutralStrokeBrush" Color="#DCDCDC" />

    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C" />

    <!-- Teintes de ticket dans la timeline (4 teintes, la roue reprend au-delà) -->
    <SolidColorBrush x:Key="TimelineHue1Brush" Color="#4B6E92" />
    <SolidColorBrush x:Key="TimelineHue1TintBrush" Color="#E7EEF5" />
    <SolidColorBrush x:Key="TimelineHue2Brush" Color="#6F5691" />
    <SolidColorBrush x:Key="TimelineHue2TintBrush" Color="#EFEAF4" />
    <SolidColorBrush x:Key="TimelineHue3Brush" Color="#1F7A6B" />
    <SolidColorBrush x:Key="TimelineHue3TintBrush" Color="#E4F1EE" />
    <SolidColorBrush x:Key="TimelineHue4Brush" Color="#8A6234" />
    <SolidColorBrush x:Key="TimelineHue4TintBrush" Color="#F4EDE3" />

    <!-- Inactivité — gris plein, sans liseré -->
    <SolidColorBrush x:Key="TimelineIdleFillBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="TimelineIdleStrokeBrush" Color="#E0E0E0" />

    <!-- Non corrélé — hachures 135°, pas de 6 px (le rendu du motif revient au contrôle de timeline) -->
    <SolidColorBrush x:Key="TimelineUncorrelatedFillBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="TimelineUncorrelatedStrokeBrush" Color="#BDBDBD" />

</ResourceDictionary>
