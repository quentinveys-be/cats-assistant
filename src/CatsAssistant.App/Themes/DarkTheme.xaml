<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Jetons couleur thème sombre — docs/design/tokens/design-tokens.dc.html (issue #16). Mêmes clés que
         LightTheme.xaml, valeurs sombres uniquement. -->

    <Color x:Key="SystemAccentColor">#5980A6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="#272727" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#232323" />
    <SolidColorBrush x:Key="SubtleFillSecondaryBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="SubtleFillTertiaryBrush" Color="#383838" />
    <SolidColorBrush x:Key="SmokeFillBrush" Color="#73000000" />

    <SolidColorBrush x:Key="DividerStrokeBrush" Color="#333333" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ControlStrokeStrongBrush" Color="#4A4A4A" />

    <SolidColorBrush x:Key="TextFillPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillSecondaryBrush" Color="#CFCFCF" />
    <SolidColorBrush x:Key="TextFillTertiaryBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="TextFillDisabledBrush" Color="#6E6E6E" />

    <SolidColorBrush x:Key="AccentFillBrush" Color="#8CA9C4" />
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#9DB6CD" />
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#7C9CBA" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A9C0D6" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#26313B" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#3E505F" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#1B2A18" />
    <SolidColorBrush x:Key="SuccessStrokeBrush" Color="#31492C" />
    <SolidColorBrush x:Key="CautionBrush" Color="#E5A34D" />
    <SolidColorBrush x:Key="CautionBgBrush" Color="#2E2418" />
    <SolidColorBrush x:Key="CautionStrokeBrush" Color="#4C3A22" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="CriticalBgBrush" Color="#2E1B1D" />
    <!-- Interpolé, voir LightTheme.xaml -->
    <SolidColorBrush x:Key="CriticalStrokeBrush" Color="#583438" />
    <SolidColorBrush x:Key="NeutralChipBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#2C2C2C" />
    <SolidColorBrush x:Key="NeutralStrokeBrush" Color="#3A3A3A" />

    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#C42B1C" />

    <!-- Teintes de ticket dans la timeline (4 teintes, la roue reprend au-delà) -->
    <SolidColorBrush x:Key="TimelineHue1Brush" Color="#8CA9C4" />
    <SolidColorBrush x:Key="TimelineHue1TintBrush" Color="#28323C" />
    <SolidColorBrush x:Key="TimelineHue2Brush" Color="#B49BD1" />
    <SolidColorBrush x:Key="TimelineHue2TintBrush" Color="#302A3A" />
    <SolidColorBrush x:Key="TimelineHue3Brush" Color="#63C4B0" />
    <SolidColorBrush x:Key="TimelineHue3TintBrush" Color="#1E2E2B" />
    <SolidColorBrush x:Key="TimelineHue4Brush" Color="#D0A971" />
    <SolidColorBrush x:Key="TimelineHue4TintBrush" Color="#302A21" />

    <!-- Inactivité — gris plein, sans liseré -->
    <SolidColorBrush x:Key="TimelineIdleFillBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TimelineIdleStrokeBrush" Color="#333333" />

    <!-- Non corrélé — hachures 135°, pas de 6 px (le rendu du motif revient au contrôle de timeline) -->
    <SolidColorBrush x:Key="TimelineUncorrelatedFillBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TimelineUncorrelatedStrokeBrush" Color="#454545" />

    <!-- Motif de hachures du segment "non corrélé" (issue #17), voir LightTheme.xaml. -->
    <DrawingBrush x:Key="TimelineUncorrelatedHatchBrush" Viewport="0,0,6,6" ViewportUnits="Absolute" TileMode="Tile">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#2A2A2A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,6,6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#454545" Thickness="1.4" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,6" EndPoint="6,0" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
