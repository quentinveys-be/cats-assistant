<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Styles implicites des contrôles récurrents (issue #16) : boutons, chips de statut, interrupteur,
         cartes. Toutes les couleurs sont en DynamicResource pour suivre la bascule clair/sombre à chaud.
         ponytail : pas de steppers ni de segmented control ici — aucun écran ne les consomme encore et
         leur gabarit exact (valeurs min/max, segments) sera fixé par l'écran qui les introduira ; les
         ajouter à l'aveugle risquerait de ne pas correspondre à la maquette réelle. -->

    <DropShadowEffect x:Key="CardShadowEffect" Color="Black" Opacity="0.07" BlurRadius="3" ShadowDepth="1" Direction="270" />
    <DropShadowEffect x:Key="FlyoutShadowEffect" Color="Black" Opacity="0.14" BlurRadius="16" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="ModalShadowEffect" Color="Black" Opacity="0.19" BlurRadius="64" ShadowDepth="32" Direction="270" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
    </Style>

    <!-- Boutons : primaire (accent plein), secondaire (contour), destructeur (danger) — mêmes métriques
         que la démo des jetons (hauteur 32, rayon 4). -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CriticalStrokeBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CriticalBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip de statut d'une ligne CATS : Proposé (accent) / Modifié (caution) / Validé (success) /
         Soumis (neutre). Content attend une chaîne (label du statut). -->
    <Style x:Key="StatusChipBaseStyle" TargetType="ContentControl">
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Height="20" Padding="{TemplateBinding Padding}" CornerRadius="3"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentStatusChipStyle" TargetType="ContentControl" BasedOn="{StaticResource StatusChipBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentStrokeBrush}" />
    </Style>

    <Style x:Key="CautionStatusChipStyle" TargetType="ContentControl" BasedOn="{StaticResource StatusChipBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
        <Setter Property="Background" Value="{DynamicResource CautionBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CautionStrokeBrush}" />
    </Style>

    <Style x:Key="SuccessStatusChipStyle" TargetType="ContentControl" BasedOn="{StaticResource StatusChipBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessStrokeBrush}" />
    </Style>

    <Style x:Key="NeutralStatusChipStyle" TargetType="ContentControl" BasedOn="{StaticResource StatusChipBaseStyle}">
        <Setter Property="Foreground" Value="{DynamicResource NeutralChipBrush}" />
        <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeutralStrokeBrush}" />
    </Style>

    <!-- Interrupteur (toggle) : CheckBox retemplaté en piste + poignée Fluent. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource ControlStrokeStrongBrush}"
                                BorderBrush="{DynamicResource ControlStrokeStrongBrush}" />
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource CardBackgroundBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
